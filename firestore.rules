rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidScroll(data) {
      return data.id is string
        && data.sender is string
        && data.sender.size() > 0
        && data.senderRole in ['chif3n', 'leslye', 'demigod']
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.timestamp is number;
    }

    function isValidArcadeState(data) {
      return data.activeGame in ['board', 'trivia', 'alchemy']
        && data.lastUpdated is number;
    }

    match /loveScrolls/{scrollId} {
      allow read: if true;
      allow create: if isValidScroll(request.resource.data);
      allow update: if isValidScroll(request.resource.data);
      allow delete: if false;
    }

    match /coupleArcade/{docId} {
      allow read: if true;
      allow create, update: if isValidArcadeState(request.resource.data);
      allow delete: if false;
    }
  }
}
